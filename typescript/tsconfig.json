{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler", 
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rewriteRelativeImportExtensions": true,
    "allowArbitraryExtensions": true
    
  },
  "include": ["src/**/*", "typings/**/*.ts"],
  "exclude": ["./node_modules"]
}
