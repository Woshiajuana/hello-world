{
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext", 
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rewriteRelativeImportExtensions": true,
  },
  "include": ["src"],
  "exclude": ["./node_modules"]
}
